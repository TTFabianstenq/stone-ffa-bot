# ============================================
# Stone FFA Bot Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file to Git.

# Required: Discord Bot Token from the Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional but recommended: Your Discord Server (Guild) ID
# Right-click server icon > Copy Server ID (Developer Mode must be enabled)
GUILD_ID=123456789012345678

# Log channel where moderation and event logs are sent
LOG_CHANNEL_ID=123456789012345678

# Role IDs
STAFF_ROLE_ID=123456789012345678
ADMIN_ROLE_ID=123456789012345678

# Ticket system
TICKET_CATEGORY_ID=123456789012345678
TRANSCRIPT_CHANNEL_ID=123456789012345678

# Optional: Maximum open tickets per user (default 1)
MAX_TICKETS_PER_USER=1

# Optional: Bot status / activity text
BOT_ACTIVITY=Stone FFA | /help

# Optional: Prefix for any legacy text commands (slash commands are primary)
# COMMAND_PREFIX=!

# Database path (relative to project root or absolute)
DATABASE_PATH=data/stone_ffa.db
